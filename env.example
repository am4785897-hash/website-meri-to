# Copy this file to ".env" (same folder, next to webserver.py) and fill
# in real values there. ".env" is already in .gitignore, so it never
# gets committed - only this .env.example template does.
#
# Nothing below is required - the app runs fine with all of it empty or
# missing. Each one just unlocks an optional feature.

# --- AI Tutor (see ai_provider.py) ---
# Set ONE of these to make the AI Tutor use a real model instead of the
# built-in mock. Hugging Face is checked first if both are set.
HUGGINGFACE_API_KEY=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
AI_PROVIDER_API_KEY=

# --- "Continue with Google/GitHub" login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Production only (leave blank for local development) ---
# SECRET_KEY=
# DATABASE_URL=
# SESSION_COOKIE_SECURE=true
